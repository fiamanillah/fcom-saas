{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:migrate": "turbo -F @syncdocket/db db:migrate",
    "test": "bun --bun vitest run --passWithNoTests",
    "check:boundaries": "bun run ../../scripts/check-module-boundaries.ts",
    "lint:imports": "bun run ../../scripts/check-module-boundaries.ts",
    "dev": "bun run --hot src/index.ts",
    "start": "NODE_ENV=production bun run dist/index.mjs"
  },
  "dependencies": {
    "@syncdocket/db": "workspace:*",
    "@syncdocket/env": "workspace:*",
    "@syncdocket/infra": "workspace:*",
    "@sentry/node": "^10.73.0",
    "bullmq": "^6.3.4",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@syncdocket/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "drizzle-kit": "^0.31.10",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  }
}
