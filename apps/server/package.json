{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@fcom-saas/db": "workspace:*",
    "@fcom-saas/env": "workspace:*",
    "@plunk/node": "^3.0.3",
    "@sentry/node": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "bullmq": "^6.3.4",
    "dotenv": "catalog:",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fcom-saas/config": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  }
}
