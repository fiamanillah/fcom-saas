{
  "name": "@fcom-saas/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./components/*": {
      "default": "./src/components/*.tsx"
    },
    "./lib/*": {
      "default": "./src/lib/*.ts"
    },
    "./*": {
      "default": "./src/components/*.tsx"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fcom-saas/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
