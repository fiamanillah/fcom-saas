{
  "name": "fcom-saas",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.5.4",
      "@types/bun": "^1.4.2",
      "msw": "^2.15.0",
      "vitest": "5.0.0",
      "@vitest/ui": "5.0.0",
      "@vitest/coverage-v8": "5.0.0",
      "jsdom": "^30.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:app": "turbo -F app dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @fcom-saas/db db:push",
    "db:studio": "turbo -F @fcom-saas/db db:studio",
    "db:generate": "turbo -F @fcom-saas/db db:generate",
    "db:migrate": "turbo -F @fcom-saas/db db:migrate",
    "test": "bun run --filter app test && bun run --filter server test",
    "secrets:scan": "gitleaks git --redact --verbose",
    "secrets:scan:staged": "gitleaks git --pre-commit --redact --staged --verbose",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@fcom-saas/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@fcom-saas/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.12",
    "turbo": "2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
